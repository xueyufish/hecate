# direnv hook for Hecate.
#
# Auto-activates `.venv` on `cd` into this repo (including any worktree
# created via `git worktree add`). Bootstraps the venv with dev deps if
# it is missing or incomplete.
#
# One-time setup per machine:
#   brew install direnv                          # macOS
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc # zsh
#   echo 'eval "$(direnv hook bash)"' >> ~/.bashrc # bash
#   direnv allow                                # run once per clone
#
# Why a custom layout (and not `use uv`): Hecate keeps all dependencies
# (including dev tooling) under `[project.optional-dependencies].dev`
# and has no `[project.dependencies]` block. `uv sync` would resolve
# nothing. We use `uv pip install -e .[dev]` instead, mirroring the
# install command documented in AGENTS.md.

export VIRTUAL_ENV="$PWD/.venv"

# Bootstrap on first entry — create venv and install dev extras.
if [[ ! -d "${VIRTUAL_ENV}" ]]; then
    uv venv "${VIRTUAL_ENV}"
    uv pip install --prerelease=allow -e ".[dev]"
fi

# Reinstall if the package is missing or venv is partial (e.g., user
# created the venv manually without the dev extras, or stale install).
if [[ ! -x "${VIRTUAL_ENV}/bin/python" ]] || \
   ! "${VIRTUAL_ENV}/bin/python" -c "import hecate" 2>/dev/null; then
    uv pip install --prerelease=allow -e ".[dev]"
fi

# Prepend venv bin to PATH so `python`, `pytest`, `ruff`, `mypy`, etc.
# resolve from the activated venv without manual `source .venv/bin/activate`.
PATH_add "${VIRTUAL_ENV}/bin"
