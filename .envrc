# direnv hook for Hecate.
#
# Auto-activates `.venv` on `cd` into this repo (including any worktree
# created via `git worktree add`). Bootstraps the venv with dev deps if
# it is missing or incomplete.
#
# One-time setup per machine:
#   brew install direnv                          # macOS
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc # zsh
#   echo 'eval "$(direnv hook bash)"' >> ~/.bashrc # bash
#   direnv allow                                # run once per clone
#
# Why a custom layout (and not `use uv`): Hecate is a uv workspace with
# a root-as-member `hecate` package plus `packages/*` members (added
# by PR1.1). `use uv` would skip workspace resolution. We run `uv sync`
# explicitly so the lockfile and member dependencies are honored.

export VIRTUAL_ENV="$PWD/.venv"

# Bootstrap on first entry — create venv and install workspace (root + members).
# --package hecate --package hecate-enterprise: explicit member list so uv
# installs all current workspace members (not just the root). --extra dev
# instead of --all-extras: avoid the `security` extra's onnxruntime transitive
# dep that lacks x86_64 wheels on this machine.
if [[ ! -d "${VIRTUAL_ENV}" ]]; then
    uv venv "${VIRTUAL_ENV}"
    uv sync --package hecate --package hecate-enterprise --package hecate-memory --package hecate-ops --package hecate-llm --package hecate-sandbox --package hecate-channel-slack --package hecate-channel-feishu --extra dev --prerelease=allow
fi

# venv layout differs per platform: bin/ on macOS+Linux, Scripts/ on Windows.
VENV_PY="${VIRTUAL_ENV}/bin/python"
if [[ ! -x "${VENV_PY}" ]]; then
    VENV_PY="${VIRTUAL_ENV}/Scripts/python.exe"
fi

# Reinstall if the package is missing or venv is partial.
if [[ ! -x "${VENV_PY}" ]] || \
   ! "${VENV_PY}" -c "import hecate, hecate_enterprise" 2>/dev/null; then
    uv sync --package hecate --package hecate-enterprise --package hecate-memory --package hecate-ops --package hecate-llm --package hecate-sandbox --package hecate-channel-slack --package hecate-channel-feishu --extra dev --prerelease=allow
fi

# Prepend the venv executable dir to PATH so `python`, `pytest`, `ruff`,
# `mypy`, etc. resolve from the activated venv without manual activation.
if [[ -d "${VIRTUAL_ENV}/bin" ]]; then
    PATH_add "${VIRTUAL_ENV}/bin"
else
    PATH_add "${VIRTUAL_ENV}/Scripts"
fi
