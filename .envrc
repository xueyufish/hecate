# direnv activation for Hecate and its worktrees.
# One-time setup: install direnv, add its shell hook, then run direnv allow.
# macOS: brew install direnv
# bash: echo 'eval "$(direnv hook bash)"' >> ~/.bashrc
# zsh:  echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc

watch_file uv.lock pyproject.toml scripts/dev.py
for manifest in packages/*/pyproject.toml packages/channels/*/pyproject.toml; do
    [[ ! -f "${manifest}" ]] || watch_file "${manifest}"
done

if ! bash scripts/dev.sh sync --check --profile "${HECATE_DEV_PROFILE:-dev}"; then
    bash scripts/dev.sh sync --profile "${HECATE_DEV_PROFILE:-dev}" || return 1
fi
export VIRTUAL_ENV="$PWD/.venv"
if [[ -d "${VIRTUAL_ENV}/bin" ]]; then
    PATH_add "${VIRTUAL_ENV}/bin"
else
    PATH_add "${VIRTUAL_ENV}/Scripts"
fi
