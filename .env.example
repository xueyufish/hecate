# =============================================================================
# Database — PostgreSQL 16 (async driver)
# =============================================================================
# Async connection string for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://hecate:hecate@localhost:5432/hecate
# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=hecate

# =============================================================================
# Vector Store — pluggable backends
# =============================================================================
# Backend selector: "qdrant" or "chroma"
VECTOR_STORE_TYPE=qdrant
# Qdrant endpoint (used when VECTOR_STORE_TYPE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Chroma persistence directory (used when VECTOR_STORE_TYPE=chroma)
CHROMA_PERSIST_DIR=./data/chroma

# =============================================================================
# Object Storage — MinIO
# =============================================================================
# MinIO endpoint for document / file storage
MINIO_URL=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Default bucket name for Hecate assets
MINIO_BUCKET=hecate

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# OpenAI-compatible API key (used by LiteLLM for routing)
OPENAI_API_KEY=
# Anthropic API key
ANTHROPIC_API_KEY=

# =============================================================================
# Security & Rate Limiting
# =============================================================================
# Comma-separated API keys for Hecate management API authentication
HECATE_API_KEYS=
# Enable LLM Guard input/output scanning (true/false)
LLM_GUARD_ENABLED=true
# Max requests per minute per client
RATE_LIMIT_RPM=60

# =============================================================================
# MCP (Model Context Protocol)
# =============================================================================
# Enable MCP Server (exposes Hecate capabilities as MCP tools)
MCP_SERVER_ENABLED=false
# MCP Server bind host
MCP_SERVER_HOST=0.0.0.0
# MCP Server bind port
MCP_SERVER_PORT=8000
# MCP auth mode: "api_key", "jwt", or "none"
MCP_AUTH_TYPE=api_key
# MCP transport: "http" (Streamable HTTP)
MCP_TRANSPORT=http
# MCP Client connection timeout in seconds
MCP_CLIENT_TIMEOUT=30

# Context Offloading (1.3.15b): write overflow conversation context to the
# AgentEnvironment filesystem instead of discarding it. The agent can retrieve
# offloaded content via the read_file tool.
CONTEXT_OFFLOAD_ENABLED=true
# Minimum token overflow that triggers offload. Prevents trivially small writes.
CONTEXT_OFFLOAD_THRESHOLD_TOKENS=6000

# Sandbox Environment Mount (1.3.15c): mount agent environment into sandbox
# containers at /mnt/env. "rw" allows sandbox writes; "ro" is read-only.
SANDBOX_MOUNT_MODE=rw

# =============================================================================
# Agent Environment & Docker Backend (1.3.15 / 1.3.15a)
# =============================================================================
# Backend type for AgentEnvironment: "local" (filesystem) or "docker" (container)
AGENT_ENV_BACKEND=local
# Agent environment idle TTL in seconds (default: 86400 = 24h)
AGENT_ENV_TTL=86400
# Docker image for DockerEnvironment containers
DOCKER_AGENT_IMAGE=python:3.12-slim
# OCI runtime: "runc" (default) or "runsc" (gVisor user-space kernel)
DOCKER_RUNTIME=runc
# Docker network mode: "none" (default), "bridge", "host"
DOCKER_NETWORK_MODE=none
# Warm pool size for reusable Docker containers
DOCKER_WARM_POOL_SIZE=10
# Warm pool idle timeout in seconds (default: 3600 = 1h)
DOCKER_WARM_POOL_IDLE_TIMEOUT=3600

# =============================================================================
# Environment Security (5.9 P0)
# =============================================================================
# Network egress policy: "allow_all" (default, backward compatible) or
# "deny_all" (only whitelisted domains reachable from agent containers).
# When deny_all, configure allowed domains per-agent or per-workspace.
AGENT_ENV_NETWORK_POLICY=allow_all
# Structured tool decision audit pipeline: records every policy evaluation
# (ToolPolicyPipeline + ToolAccessPolicy) as a queryable ToolDecisionEvent.
AGENT_ENV_DECISION_ENABLED=true
# Retention period for tool decision events in days (auto-cleanup).
AGENT_ENV_DECISION_RETENTION_DAYS=30
# Async batch writer: flush after N events or T seconds (whichever first).
AGENT_ENV_DECISION_BATCH_SIZE=50
AGENT_ENV_DECISION_FLUSH_INTERVAL=5.0

# SIEM Export Pipeline: export security events to external SIEM systems.
SIEM_ENABLED=false
# Comma-separated exporters to enable: "webhook,syslog,ocsf"
SIEM_EXPORTERS=
# Event type filter: "api,tool_policy,anomaly" (empty = all)
SIEM_FILTER_EVENT_TYPES=
# Minimum severity: info | low | medium | high | critical
SIEM_MIN_SEVERITY=info
SIEM_BATCH_SIZE=50
SIEM_FLUSH_INTERVAL=5.0
# Webhook exporter config
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=
SIEM_WEBHOOK_FORMAT=json
SIEM_WEBHOOK_HEADERS={}
# Syslog exporter config
SIEM_SYSLOG_HOST=localhost
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTOCOL=tcp
SIEM_SYSLOG_TLS=false
SIEM_SYSLOG_FACILITY=4
# Security Finding retention (days)
SECURITY_FINDING_RETENTION_DAYS=90
# Per-execution credential scoping: strip secret env vars (*_KEY, *_SECRET,
# *_TOKEN, *_PASSWORD, HECATE_SECRET_*) before tool execution. Inject only
# per-tool scoped credentials. DockerEnvironment only.
AGENT_ENV_CREDENTIAL_SCOPING=false
# Sandbox enforcement: EXECUTE_SANDBOX decisions route shell/exec tools to
# DockerEnvironment container instead of direct host execution.
AGENT_ENV_SANDBOX_ENFORCEMENT=false
